camera mono
view matrix camera 0.52624,0.71629,0.45825,165.97,-0.14546,-0.45514,0.87846,186,0.8378,-0.52894,-0.13532,124.6
col #1/A:234 royalblue
hide #1.2-10
show #1.3
transparency #1.3 50 target p
sel #1/A:234,478,237,230
show sel a
sel ~sel
sel subtract #2
hide sel
sel #2
select subtract #2/M:1@M/M:4@M/M:5@M/M:7@M
hide sel
hide #4-5
set bgColor white
lighting soft
lighting shadows false
label #1/A:234 offset 2.5,-1.5,0 color royalblue
label #1/A:478 offset -1.2,0.6,0
label #1/A:237 offset 3.0,-1.1,-1.9
label #1/A:230 offset 1.0,-1.3,0
view name 7DRT
clip near off
clip near -21
clip far off
clip far 5
ui tool show "Side View"
save ./figures/7DRT_1.png width 1979 height 1112 supersample 3
save ./figures/7drt_hydrogenated_1.cxs
close all
open ./output/arpeggio_docker_results/7drt_hydrogenated/7drt_hydrogenated_hydrogenated.pdb
open ./output/opm_structures/7drt_opm.pdb
mm #1 to #2.1
view orient
turn X 90
select ::name="DUM"
show sel
select add #1
hide ~sel
hide ~sel r
hide #!1.1 models
sel clear
lighting soft
lighting shadows false
col #1/A:234,354 royalblue
view matrix camera 0.98481,5.2503e-09,-0.17365,-57.265,0.17365,1.3739e-09,0.98481,332.24,1.0219e-08,-1,4.4132e-10,11.326
