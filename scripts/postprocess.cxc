# open ./output/missense3d_tm/6bd4_L485F_missense3d_tm/jobs/0xf50020x38f699/SCWRL/L485F_6bd4_hydrogenated.pdb
open ./output/ddmut/ddmut_17654363667596319_6BD4_L485F_mutant.pdb
rename #1 L485F_6bd4_hydrogenated
select protein
del ~sel
altlocs clean
# save ./output/processed_structures/[NAME]_clean.pdb
addh #1 hbond false
save ./output/processed_structures/[NAME].pdb
close all

